---
// The homepage: a visual novel title screen as the hero, then what it does, how to start, and a share band.
import "../styles/home.css";
import logoSource from "../../../logo/eye-blink.svg?raw";
import { home } from "../i18n/home";

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = home[locale];
const REPO = "https://github.com/lulalala/visual-novel-eye-controller";

// The logo is inlined so its blink animation can be read with getCurrentTime().
const logo = logoSource
  .replace(/<\?xml[^>]*\?>\s*/, "")
  .replace('width="352" height="352"', 'width="100%" height="100%"');

const path = (l: string) => (l === "en" ? "/" : `/${l}/`);
const docsPath = locale === "en" ? "/guide/getting-started/" : `/${locale}/guide/getting-started/`;
const alternates = Astro.site
  ? Object.keys(home).map((l) => ({ l, href: new URL(path(l), Astro.site).href }))
  : [];
---
<!doctype html>
<html lang={t.lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{t.title}</title>
<meta name="description" content={t.description}>
<meta property="og:type" content="website">
<meta property="og:title" content={t.title}>
<meta property="og:description" content={t.ogDescription}>
<meta name="twitter:card" content="summary">
<meta name="keywords" content={t.keywords}>
<meta name="theme-color" content="#F8F9FF">
<link rel="icon" href="/logo.svg" type="image/svg+xml">
{alternates.length > 1 && alternates.map((a) => <link rel="alternate" hreflang={a.l} href={a.href} />)}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700;900&family=JetBrains+Mono:wght@500&display=swap">
</head>
<body
  id="home"
  data-lines={JSON.stringify(t.lines)}
  data-hint-click={t.hintClick}
  data-copy={t.share.copy}
  data-copied={t.share.copied}
  data-share-message={t.share.message}
>

<div class="wrap">
  <nav>
    <a class="mark" href="#top"><i></i>eyeokuri</a>
    <div class="links">
      <a class="navbtn" href={`${REPO}/releases/latest`}>{t.nav.download}</a>
      <a href={docsPath}>{t.nav.docs}</a>
      <a href={REPO}>{t.nav.github}</a>
    </div>
  </nav>

  <main class="top" id="top">
  <section class="stage" aria-label={t.demoLabel}>
    <div class="bands" aria-hidden="true"><span></span><span></span><span></span></div>
    <i class="spark" style="left:46%;top:10%;--s:26px;--d:0s" aria-hidden="true"></i>
    <i class="spark" style="left:8%;top:62%;--s:14px;--d:1.1s" aria-hidden="true"></i>
    <i class="spark" style="right:6%;top:46%;--s:30px;--d:.6s" aria-hidden="true"></i>
    <i class="spark" style="right:30%;top:6%;--s:16px;--d:2s" aria-hidden="true"></i>

    <div class="titlebar" aria-hidden="true"><b></b><b></b><b></b></div>

    <div class="title">
      <h1>{t.heroLine1}<br><span class="next">{t.heroLine2}</span></h1>
      <p class="sub">{t.sub}</p>
      <div class="cta">
        <a class="btn big" href={`${REPO}/releases/latest`}>{t.cta}</a>
        <p class="meta">{t.meta}</p>
      </div>
    </div>

    <div class="portrait">
      <div class="eye" role="img" aria-label={t.eyeLabel}>
        <span class="key" id="key" aria-hidden="true"><span set:html={t.enterSent} /></span>
        <Fragment set:html={logo} />
      </div>
    </div>

    <div class="dialog" id="dialog" tabindex="0" role="button" aria-label={t.dialogLabel}>
      <span class="name">{t.speaker}</span>
      <p class="line" id="line" aria-live="polite"></p>
      <div class="foot">
        <span class="dots" id="dots" aria-hidden="true"></span>
        <span id="hint">{t.hintBlink} <span class="next-ind">▼</span></span>
      </div>
    </div>
  </section>
  </main>

  <section class="sec controls" id="gestures">
    <div class="intro">
      <span class="kicker">{t.gestures.kicker}</span>
      <h2>{t.gestures.title}</h2>
      <p>{t.gestures.text}</p>
    </div>
    <div class="panel">
      <p class="panel-head" aria-hidden="true">{t.gestures.panel}</p>
      <ul>
        {t.gestures.rows.map((r) => (
          <li class={r.on ? "" : "off"}>
            <span class="what"><b>{r.gesture}</b><small>{r.note}</small></span>
            <span class="glyph">{r.key}</span>
            <span class="switch"><span class="sr">{r.on ? t.gestures.on : t.gestures.off}</span></span>
          </li>
        ))}
      </ul>
      <p class="panel-foot">{t.gestures.foot}</p>
    </div>
  </section>

  <section class="sec start" id="install">
    <span class="kicker">{t.start.kicker}</span>
    <h2>{t.start.title}</h2>
    <ol class="steps">
      {t.start.steps.map((st) => (
        <li><b>{st.title}</b><span set:html={st.text} /></li>
      ))}
    </ol>
    <a class="btn big" href={`${REPO}/releases/latest`}>{t.start.button}</a>
    <ul class="trust">
      {t.start.trust.map((x) => <li>{x}</li>)}
    </ul>
  </section>

  <section class="sec pass">
    <h2>{t.pass.title}</h2>
    <p>{t.pass.text}</p>
    <div class="share">
      <button class="chipbtn" id="share-copy" type="button">{t.share.copy}</button>
      <a class="chipbtn" id="share-bsky" href="#" target="_blank" rel="noopener">Bluesky</a>
      <a class="chipbtn" id="share-x" href="#" target="_blank" rel="noopener">X</a>
      <a class="chipbtn" id="share-reddit" href="#" target="_blank" rel="noopener">Reddit</a>
    </div>
    <p class="follow">
      <a class="btn alt" href={REPO}>{t.pass.star}</a>
      <a class="textlink" href={`${REPO}/issues`}>{t.pass.request}</a>
    </p>
  </section>

  <footer>
    <span>{t.footer}</span>
    <div class="foot-links">
      <a href={docsPath}>{t.nav.docs}</a>
      <a href={REPO}>{t.nav.github}</a>
      <a href={`${REPO}/releases`}>{t.footerReleases}</a>
    </div>
  </footer>
</div>
<script>
  import "../scripts/home.js";
</script>
</body>
</html>
